# === REQUIRED (server will fail to start without these) ===

# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Email (Resend)
RESEND_API_KEY=

# === OPTIONAL ===

# Admin features (impersonation, audit logs, usage tracking)
# SUPABASE_SERVICE_ROLE_KEY=

# Email sender address
# EMAIL_FROM=MediTalk <noreply@meditalk.ai>

# Admin impersonation (comma-separated emails)
# ADMIN_EMAILS=admin@meditalk.ai

# Domain configuration (only needed for subdomain setup)
# NEXT_PUBLIC_APP_URL=https://app.meditalk.ai

# Default locale: sk | cs | en
NEXT_PUBLIC_DEFAULT_LOCALE=sk

# Debug console (set to "true" to enable Eruda)
# NEXT_PUBLIC_ENABLE_ERUDA=

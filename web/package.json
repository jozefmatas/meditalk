{
  "name": "meditalk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8111",
    "dev:https": "next dev -p 8111 --experimental-https --experimental-https-key ./certs/localhost+1-key.pem --experimental-https-cert ./certs/localhost+1.pem",
    "build": "next build",
    "cap:build": "npx cap sync",
    "start": "next start",
    "cap:sync": "npx cap sync",
    "cap:ios": "xattr -cr ios && npx cap run ios",
    "cap:android": "$ANDROID_HOME/platform-tools/adb reverse tcp:8111 tcp:8111 && cd android && ./gradlew clean && cd .. && npx cap run android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "lint": "eslint",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "storybook": "storybook dev -p 8001",
    "build-storybook": "storybook build",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset --linked --yes",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "db:migration:new": "supabase migration new",
    "db:status": "supabase migration list --linked"
  },

<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Allow self-signed dev certs for local Next.js HTTPS server -->
  <debug-overrides>
    <trust-anchors>
      <certificates src="user" />
      <certificates src="system" />
    </trust-anchors>
  </debug-overrides>
  <!-- Allow cleartext for dev (Capacitor sets cleartext flag dynamically) -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </base-config>
</network-security-config>
